# ==========================================
# Voltgrid Environment Variables Configuration
# Copy this file to '.env' and fill in your details
# ==========================================

# Database connection details (SQLite for quick local run, or PostgreSQL for production)
# SQLite (out-of-the-box, no database setup required):
DATABASE_URL=sqlite:///voltgrid.db

# PostgreSQL connection details (optional):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=voltgrid

# Optional: Gmail SMTP Details for real OTP emails
# If left blank, OTPs will print to your terminal console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
